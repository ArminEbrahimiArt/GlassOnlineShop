---
/**
 * Icon set: Lucide, the icon family used by shadcn/ui (ADR-010).
 * Icons are inlined at build time from `lucide-static`, so they cost no
 * runtime JS. Every icon shares the same 24px grid, round caps and a 1.5px
 * stroke, for one consistent, refined family.
 *
 * Add an icon: map a short name to its Lucide export name below.
 * Browse names at https://lucide.dev/icons
 * Icons that point in a direction get `flip` so they mirror in RTL.
 */
import * as lucide from 'lucide-static';

const map = {
  menu: 'Menu',
  close: 'X',
  bag: 'ShoppingBag',
  arrow: 'ArrowRight',
  arrowLeft: 'ArrowLeft',
  arrowUpRight: 'ArrowUpRight',
  chevronLeft: 'ChevronLeft',
  chevronRight: 'ChevronRight',
  chevronDown: 'ChevronDown',
  plus: 'Plus',
  minus: 'Minus',
  camera: 'Camera',
  info: 'Info',
  mirror: 'ScanFace',
  glasses: 'Glasses',
  search: 'Search',
  upload: 'ImageUp',
  download: 'Download',
  share: 'Share',
  globe: 'Globe',
  check: 'Check',
  sparkle: 'Sparkles',
  lock: 'Lock',
  home: 'House',
  store: 'Store',
  expand: 'Expand',
  zoom: 'ZoomIn',
  truck: 'Truck',
  shield: 'ShieldCheck',
  hand: 'Hand',
} as const;

export type IconName = keyof typeof map;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  flip?: boolean;
  stroke?: number;
}
const { name, size = 20, class: cls, flip = false, stroke = 1.5 } = Astro.props;
const raw = (lucide as Record<string, string>)[map[name]] ?? '';
// Keep only the drawing (children of <svg>); we render our own wrapper.
const inner = raw.slice(raw.indexOf('>') + 1, raw.lastIndexOf('</svg>'));
---

<svg
  class:list={['icon', cls, { 'flip-rtl': flip }]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
