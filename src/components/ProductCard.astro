---
/**
 * Grid card (shop, related). Soft stone stage, second image on hover
 * (desktop), quick-add "+" and quick try-on (app-style, see the mobile
 * reference in docs/DESIGN-SYSTEM.md). The card body is one link; the two
 * action buttons sit above it.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Product } from '@/data/products';
import { formatPrice, href, pick, useT, type Locale } from '@/i18n/utils';

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
  i?: number;
}
const { product: p, locale, eager = false, i = 0 } = Astro.props;
const t = useT(locale);
const [first, second] = p.images;
const sizes = '(min-width: 1024px) 30vw, 50vw';
const name = pick(p.name, locale);
---

<article class="card" data-reveal style={`--reveal-i:${i % 3}`} data-tone={p.tone} data-category={p.category} data-price={p.price}>
  <a class="card__link" href={href(`/product/${p.slug}`, locale)}>
    <div class="card__stage" style={`--stage:${p.stage}`}>
      <Image class="card__img" src={first.src} alt={pick(first.alt, locale)} widths={[360, 560, 800, 1100]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} format="webp" quality={80} />
      {second && <Image class="card__img card__img--alt" src={second.src} alt="" widths={[360, 560, 800, 1100]} sizes={sizes} loading="lazy" format="webp" quality={80} />}
      {p.isNew && <span class="card__badge label">{t('common.new')}</span>}
    </div>
    <div class="card__info">
      <h3 class="card__name">{name}</h3>
      <p class="card__price">{formatPrice(p.price, locale)}</p>
      <ul class="card__dots" role="list" aria-label={t('common.colour')}>
        {p.colourways.map((c) => <li style={`background:${c.swatch}`} title={pick(c.name, locale)} />)}
      </ul>
    </div>
  </a>
  <button class="card__btn card__btn--try" type="button" data-tryon-open data-slug={p.slug} aria-label={`${t('common.tryOn')} — ${name}`}>
    <Icon name="mirror" size={18} />
  </button>
  <button class="card__btn card__btn--add" type="button" data-add-to-cart data-slug={p.slug} data-no-drawer aria-label={`${t('common.quickAdd')} — ${name}`}>
    <Icon name="plus" size={18} />
  </button>
</article>

<style>
  .card {
    position: relative;
    container-type: inline-size;
  }
  .card__link {
    display: grid;
    gap: var(--s-3);
  }
  .card__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage);
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform 1.6s var(--ease-out);
  }
  .card__img--alt {
    opacity: 0;
  }
  @media (hover: hover) {
    .card:hover .card__img {
      transform: scale(1.03);
    }
    .card:hover .card__img--alt {
      opacity: 1;
    }
  }
  .card__badge {
    position: absolute;
    top: var(--s-3);
    inset-inline-start: var(--s-3);
    padding: 4px 8px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.88);
    backdrop-filter: blur(6px);
    font-size: 10px;
  }
  .card__info {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 2px var(--s-3);
  }
  .card__name {
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }
  .card__price {
    font-size: var(--text-sm);
    color: var(--stone-600);
    white-space: nowrap;
  }
  .card__dots {
    grid-column: 1 / -1;
    display: flex;
    gap: 6px;
    margin-block-start: var(--s-2);
  }
  .card__dots li {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @container (max-width: 300px) {
    .card__info {
      grid-template-columns: 1fr;
    }
  }

  /* Action buttons over the image */
  .card__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
    color: var(--ink);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast);
  }
  .card__btn:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .card__btn:active {
    transform: scale(0.94);
  }
  .card__btn--try {
    top: var(--s-3);
    inset-inline-end: var(--s-3);
  }
  /* "+" sits at the bottom corner of the stage (stage is 4:5 of card width) */
  .card__btn--add {
    top: calc(100cqi * 1.25 - 36px - var(--s-3));
    inset-inline-end: var(--s-3);
    background: var(--ink);
    color: var(--paper);
  }
  .card__btn--add:hover {
    background: var(--stone-800);
  }
</style>
