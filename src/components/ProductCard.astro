---
/**
 * Grid card (shop, related). Soft stone stage, second image on hover
 * (desktop), colour dots, quick try-on. Whole card is one link; the try-on
 * button sits above it.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Product } from '@/data/products';
import { formatPrice, href, pick, useT, type Locale } from '@/i18n/utils';

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
  i?: number;
}
const { product: p, locale, eager = false, i = 0 } = Astro.props;
const t = useT(locale);
const [first, second] = p.images;
const sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---

<article class="card" data-reveal style={`--reveal-i:${i % 3}`} data-tone={p.tone} data-category={p.category} data-price={p.price}>
  <a class="card__link" href={href(`/product/${p.slug}`, locale)}>
    <div class="card__stage" style={`--stage:${p.stage}`}>
      <Image
        class="card__img"
        src={first.src}
        alt={pick(first.alt, locale)}
        widths={[400, 640, 900, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        format="webp"
        quality={80}
      />
      {
        second && (
          <Image
            class="card__img card__img--alt"
            src={second.src}
            alt=""
            widths={[400, 640, 900, 1200]}
            sizes={sizes}
            loading="lazy"
            format="webp"
            quality={80}
          />
        )
      }
      <div class="card__badges">
        {p.isNew && <span class="card__badge label">{t('common.new')}</span>}
      </div>
    </div>
    <div class="card__info">
      <div class="card__row">
        <h3 class="card__name">{pick(p.name, locale)}</h3>
        <p class="card__price">{formatPrice(p.price, locale)}</p>
      </div>
      <div class="card__row">
        <p class="card__meta muted">{pick(p.colourways[0].name, locale)}</p>
        <ul class="card__dots" role="list" aria-label={t('common.colour')}>
          {p.colourways.map((c) => <li style={`background:${c.swatch}`} title={pick(c.name, locale)} />)}
        </ul>
      </div>
    </div>
  </a>
  <button class="card__try" type="button" data-tryon-open data-slug={p.slug} aria-label={`${t('common.tryOn')} — ${pick(p.name, locale)}`}>
    <Icon name="mirror" size={18} />
    <span>{t('common.tryOn')}</span>
  </button>
</article>

<style>
  .card {
    position: relative;
    container-type: inline-size;
  }
  .card__link {
    display: block;
  }
  .card__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage);
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform 1.6s var(--ease-out);
  }
  .card__img--alt {
    opacity: 0;
  }
  @media (hover: hover) {
    .card:hover .card__img {
      transform: scale(1.035);
    }
    .card:hover .card__img--alt {
      opacity: 1;
    }
  }
  .card__badges {
    position: absolute;
    top: var(--s-3);
    inset-inline-start: var(--s-3);
    display: flex;
    gap: var(--s-1);
  }
  .card__badge {
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
  }
  .card__info {
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-1) 0;
  }
  .card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
  }
  @container (max-width: 300px) {
    .card__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .card__dots {
      margin-block-start: var(--s-1);
    }
  }
  .card__name {
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }
  .card__price {
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .card__meta {
    font-size: var(--text-xs);
  }
  .card__dots {
    display: flex;
    gap: 5px;
  }
  .card__dots li {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .card__try {
    position: absolute;
    top: var(--s-3);
    inset-inline-end: var(--s-3);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 36px;
    padding-inline: 10px;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    font-size: var(--text-xs);
    font-weight: 500;
    transition:
      background-color var(--dur-fast),
      transform var(--dur-fast);
  }
  .card__try span {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width var(--dur) var(--ease-out);
  }
  .card__try:hover,
  .card__try:focus-visible {
    background: var(--white);
  }
  .card__try:hover span,
  .card__try:focus-visible span {
    max-width: 8em;
  }
  @media (hover: none) {
    .card__try span {
      max-width: 8em;
    }
  }
</style>
