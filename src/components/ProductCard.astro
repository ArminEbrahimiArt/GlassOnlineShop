---
/**
 * Grid card (shop, related). Soft stone stage, second image on hover
 * (desktop), quick-add "+" and quick try-on (app-style, see the mobile
 * reference in docs/DESIGN-SYSTEM.md). The card body is one link; the two
 * action buttons sit above it.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Product } from '@/data/products';
import { formatPrice, href, pick, useT, type Locale } from '@/i18n/utils';

interface Props {
  product: Product;
  locale: Locale;
  eager?: boolean;
  i?: number;
}
const { product: p, locale, eager = false, i = 0 } = Astro.props;
const t = useT(locale);
const [first, second] = p.images;
const sizes = '(min-width: 1024px) 25vw, 50vw';
const name = pick(p.name, locale);
---

<article class="card" data-reveal style={`--reveal-i:${i % 4}`} data-tone={p.tone} data-category={p.category} data-price={p.price}>
  <a class="card__link" href={href(`/product/${p.slug}`, locale)}>
    <div class="card__stage" style={`--stage:${p.stage}`}>
      <Image class="card__img" src={first.src} alt={pick(first.alt, locale)} widths={[400, 640, 960, 1280]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} format="webp" quality={82} />
      {second && <Image class="card__img card__img--alt" src={second.src} alt="" widths={[400, 640, 960, 1280]} sizes={sizes} loading="lazy" format="webp" quality={82} />}
      {p.isNew && <span class="card__badge">{t('common.new')}</span>}
    </div>
    <div class="card__info">
      <div class="card__row">
        <h3 class="card__name">{name}</h3>
        <p class="card__price">{formatPrice(p.price, locale)}</p>
      </div>
      <div class="card__row card__row--meta">
        <p class="card__colour">{pick(p.colourways[0].name, locale)}</p>
        <ul class="card__dots" role="list" aria-label={t('common.colour')}>
          {p.colourways.map((c, k) => <li class:list={{ 'is-current': k === 0 }} style={`background:${c.swatch}`} title={pick(c.name, locale)} />)}
        </ul>
      </div>
    </div>
  </a>
  <button class="card__btn card__btn--try" type="button" data-tryon-open data-slug={p.slug} aria-label={`${t('common.tryOn')} — ${name}`}>
    <Icon name="mirror" size={18} />
  </button>
  <button class="card__btn card__btn--add" type="button" data-add-to-cart data-slug={p.slug} data-no-drawer aria-label={`${t('common.quickAdd')} — ${name}`}>
    <Icon name="plus" size={18} />
  </button>
</article>

<style>
  /* The card is one contained object: image + info share a surface and a
     hairline frame, so price and colours visibly belong to their product. */
  .card {
    position: relative;
    container-type: inline-size;
    background: var(--stone-50);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  @media (hover: hover) {
    .card:hover {
      border-color: var(--line-strong);
      box-shadow: var(--shadow-soft);
    }
  }
  .card__link {
    display: block;
  }
  .card__stage {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--stage);
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform 1.6s var(--ease-out);
  }
  .card__img--alt {
    opacity: 0;
  }
  @media (hover: hover) {
    .card:hover .card__img {
      transform: scale(1.03);
    }
    .card:hover .card__img--alt {
      opacity: 1;
    }
  }
  .card__badge {
    position: absolute;
    top: var(--s-3);
    inset-inline-start: var(--s-3);
    padding: 3px 7px;
    border-radius: var(--radius-xs);
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.4;
  }
  :lang(fa) .card__badge {
    font-size: var(--text-2xs);
    text-transform: none;
  }
  .card__info {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4) var(--s-4);
    border-block-start: 1px solid var(--line);
  }
  .card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    min-width: 0;
  }
  .card__row--meta {
    align-items: center;
  }
  .card__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.4;
  }
  :lang(fa) .card__name {
    letter-spacing: 0;
    text-transform: none;
    font-size: var(--text-base);
  }
  .card__price {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .card__colour {
    font-size: var(--text-xs);
    color: var(--stone-600);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card__dots {
    display: flex;
    gap: 6px;
    flex: none;
  }
  .card__dots li {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .card__dots li.is-current {
    outline: 1px solid var(--ink);
    outline-offset: 2px;
  }
  @container (max-width: 260px) {
    .card__info {
      padding: var(--s-3);
    }
    .card__row:first-child {
      flex-direction: column;
      gap: 2px;
    }
  }

  /* Action tiles over the image */
  .card__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(6px);
    color: var(--ink);
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast);
  }
  .card__btn:active {
    transform: scale(0.94);
  }
  @media (hover: hover) {
    .card__btn:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }
  .card__btn--try {
    top: var(--s-3);
    inset-inline-end: var(--s-3);
  }
  /* "+" sits at the bottom corner of the 4:3 stage */
  .card__btn--add {
    top: calc(100cqi * 0.75 - 36px - var(--s-3));
    inset-inline-end: var(--s-3);
    background: var(--ink);
    color: var(--paper);
  }
  @media (hover: hover) {
    .card__btn--add:hover {
      background: var(--stone-800);
    }
  }
</style>
