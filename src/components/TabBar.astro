---
/**
 * Mobile / tablet bottom navigation (< 1024px), inspired by app-style
 * storefronts: a floating ink bar within thumb reach. Hidden on desktop.
 * Product pages replace it with their own buy bar (BaseLayout `tabbar=false`).
 */
import Icon, { type IconName } from './Icon.astro';
import { href, neutralPath, useT, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const route = neutralPath(Astro.url.pathname).replace(/\/$/, '') || '/';

const items: { path: string; icon: IconName; label: string }[] = [
  { path: '/', icon: 'home', label: t('nav.home') },
  { path: '/shop', icon: 'glasses', label: t('nav.shop') },
  { path: '/try-on', icon: 'mirror', label: t('nav.mirrorShort') },
  { path: '/collections', icon: 'store', label: t('nav.collections') },
];
---

<nav class="tabbar" aria-label="Quick navigation">
  {
    items.map((it) => (
      <a class="tabbar__item" href={href(it.path, locale)} aria-current={route === it.path ? 'page' : undefined}>
        <Icon name={it.icon} size={21} />
        <span>{it.label}</span>
      </a>
    ))
  }
  <button class="tabbar__item" type="button" data-cart-open>
    <span class="tabbar__bag">
      <Icon name="bag" size={21} />
      <span class="tabbar__count" data-cart-count hidden>0</span>
    </span>
    <span>{t('nav.cart')}</span>
  </button>
</nav>

<style>
  .tabbar {
    position: fixed;
    z-index: 45;
    inset-inline: var(--s-3);
    bottom: calc(var(--s-3) + env(safe-area-inset-bottom));
    height: var(--tabbar-h);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    padding-inline: var(--s-2);
    background: var(--ink);
    color: var(--stone-400);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
  }
  .tabbar__item {
    display: grid;
    justify-items: center;
    gap: 3px;
    padding-block: var(--s-2);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    transition: color var(--dur-fast);
    -webkit-tap-highlight-color: transparent;
  }
  .tabbar__item[aria-current='page'] {
    color: var(--paper);
  }
  .tabbar__item[aria-current='page'] :global(.icon) {
    stroke-width: 1.9;
  }
  .tabbar__bag {
    position: relative;
  }
  .tabbar__count {
    position: absolute;
    top: -5px;
    inset-inline-end: -8px;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    border-radius: var(--radius-pill);
    background: var(--nude-300);
    color: var(--ink);
    font-size: 9px;
    font-weight: 600;
    line-height: 16px;
    text-align: center;
  }
  .tabbar__count[hidden] {
    display: none;
  }
  @media (min-width: 1024px) {
    .tabbar {
      display: none;
    }
  }
</style>
