---
/**
 * Site header: announcement bar, sticky bar, full-screen menu (a <dialog>).
 * `overlay` = transparent over a full-bleed hero until the page scrolls.
 * Behaviour lives in src/scripts/ui.ts (data-* hooks only, no inline JS).
 */
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { href, neutralPath, useT, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  overlay?: boolean;
}
const { locale, overlay = false } = Astro.props;
const t = useT(locale);
const other: Locale = locale === 'en' ? 'fa' : 'en';
const route = neutralPath(Astro.url.pathname);

const links = [
  { path: '/shop', label: t('nav.shop') },
  { path: '/collections', label: t('nav.collections') },
  { path: '/try-on', label: t('nav.mirror') },
  { path: '/atelier', label: t('nav.atelier') },
];
const active = (p: string) => route.replace(/\/$/, '') === p;
---

<a class="skip" href="#main">{t('nav.skip')}</a>

<div class="announce" data-announce>
  <p class="announce__text">{t('announce.text')}</p>
</div>

<header class:list={['header', { 'header--overlay': overlay }]} data-header>
  <div class="header__inner container">
    <div class="header__start">
      <button class="header__menu" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu">
        <Icon name="menu" />
        <span class="label">{t('nav.menu')}</span>
      </button>
      <nav class="header__nav" aria-label="Primary">
        {
          links.slice(0, 3).map((l) => (
            <a href={href(l.path, locale)} class="label" aria-current={active(l.path) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <a class="header__brand" href={href('/', locale)} aria-label="Slazenger — home">
      <Wordmark />
    </a>

    <div class="header__end">
      <a class="header__lang label" href={href(route, other)} hreflang={other} lang={other} aria-label={t('nav.langLabel')}>
        {t('nav.lang')}
      </a>
      <a class="icon-btn header__mirror" href={href('/try-on', locale)} aria-label={t('nav.mirror')}>
        <Icon name="mirror" />
      </a>
      <button class="icon-btn header__bag" type="button" data-cart-open aria-label={t('nav.cart')}>
        <Icon name="bag" />
        <span class="header__count" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" data-menu aria-label={t('nav.menu')}>
  <div class="menu__top container">
    <button class="header__menu" type="button" data-menu-close>
      <Icon name="close" />
      <span class="label">{t('nav.close')}</span>
    </button>
    <Wordmark />
    <a class="header__lang label" href={href(route, other)} hreflang={other} lang={other}>{t('nav.lang')}</a>
  </div>
  <nav class="menu__nav container" aria-label="Menu">
    <ol role="list">
      {
        [{ path: '/', label: t('nav.home') }, ...links].map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={href(l.path, locale)} aria-current={active(l.path) ? 'page' : undefined}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__label">{l.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot container">
    <p class="muted">{t('nav.menuNote')}</p>
    <div class="menu__social label">
      <a href="#" class="link">Instagram</a>
      <a href="#" class="link">Telegram</a>
      <a href="#" class="link">Pinterest</a>
    </div>
  </div>
</dialog>

<style>
  .skip {
    position: absolute;
    inset-inline-start: var(--s-4);
    top: -100px;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--radius-xs);
  }
  .skip:focus {
    top: var(--s-2);
  }

  /* ── Announcement ── */
  .announce {
    height: var(--announce-h);
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--stone-200);
    padding-inline: var(--gutter);
    overflow: hidden;
  }
  .announce__text {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  :lang(fa) .announce__text {
    letter-spacing: 0;
    font-size: var(--text-xs);
  }

  /* ── Header bar ── */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    border-block-end: 1px solid var(--line);
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .header--overlay {
    position: fixed;
    inset-inline: 0;
    top: var(--announce-h);
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
  }
  .header--overlay:global(.is-scrolled) {
    top: 0;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
    -webkit-backdrop-filter: saturate(1.4) blur(16px);
    border-color: var(--line);
  }
  .header:global(.is-hidden) {
    transform: translateY(-100%);
  }
  .header__inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-4);
  }
  .header__start,
  .header__end {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .header__end {
    justify-content: flex-end;
    gap: var(--s-1);
  }
  .header__menu {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 44px;
    margin-inline-start: -10px;
    padding-inline: 10px;
    border-radius: var(--radius-xs);
  }
  .header__menu svg {
    width: 20px;
  }
  .header__menu .label {
    display: none;
  }
  .header__nav {
    display: none;
    gap: var(--s-5);
  }
  .header__nav a {
    position: relative;
    padding-block: var(--s-2);
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .header__brand {
    display: grid;
    place-items: center;
    padding: var(--s-2);
  }
  .header__lang {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius-xs);
    display: inline-flex;
  }
  .header__lang:hover {
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }
  .header__mirror {
    display: none;
  }
  .header__bag {
    position: relative;
  }
  @media (max-width: 1023px) {
    :global(body.has-tabbar) .header__bag {
      display: none;
    }
  }
  .header__count {
    position: absolute;
    top: 6px;
    inset-inline-end: 4px;
    min-width: 17px;
    height: 17px;
    padding-inline: 4px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    font-weight: 600;
    line-height: 17px;
    text-align: center;
  }

  @media (min-width: 640px) {
    .header__menu .label {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
    .header__mirror {
      display: inline-grid;
    }
  }

  /* ── Full-screen menu ── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    display: none;
    flex-direction: column;
    opacity: 0;
    transition:
      opacity var(--dur) var(--ease-out),
      overlay var(--dur) allow-discrete,
      display var(--dur) allow-discrete;
  }
  .menu[open] {
    display: flex;
    opacity: 1;
  }
  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu__top {
    height: calc(var(--header-h) + var(--announce-h));
    padding-top: var(--announce-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .menu__top .header__lang {
    display: inline-flex;
    justify-self: end;
  }
  .menu__top .header__menu .label {
    display: inline;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
  }
  .menu__nav ol {
    width: 100%;
    border-block-start: 1px solid var(--line);
  }
  .menu__nav li {
    border-block-end: 1px solid var(--line);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    transition-delay: calc(var(--i) * 50ms + 80ms);
  }
  .menu[open] li {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .menu[open] li {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: clamp(0.6rem, 1.6vh, 1.2rem);
    transition: color var(--dur-fast);
  }
  .menu__nav .mono {
    color: var(--stone-500);
    min-width: 2ch;
  }
  .menu__label {
    font-size: clamp(2rem, 1.2rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    transition: transform var(--dur) var(--ease-out);
  }
  .menu__nav a:hover .menu__label {
    transform: translateX(12px);
  }
  :global([dir='rtl']) .menu__nav a:hover .menu__label {
    transform: translateX(-12px);
  }
  .menu__nav a[aria-current='page'] .mono {
    color: var(--nude-700);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-6);
    font-size: var(--text-sm);
  }
  .menu__social {
    display: flex;
    gap: var(--s-5);
  }
</style>
