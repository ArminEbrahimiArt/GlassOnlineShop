---
/**
 * Checkout — UI only in Phase 1. The summary is rendered client-side from
 * the bag. Payment gateway integration is Phase 3 (docs/ROADMAP.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { href, useT, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<BaseLayout locale={locale} title={t('checkout.title')} page="checkout" footer={false}>
  <div class="co container">
    <form class="co__form" data-checkout novalidate>
      <h1 class="t-h2 co__title">{t('checkout.title')}</h1>

      <fieldset>
        <legend class="label">01 — {t('checkout.contact')}</legend>
        <div class="field"><input id="f-name" placeholder=" " autocomplete="name" /><label for="f-name">{t('checkout.name')}</label></div>
        <div class="row">
          <div class="field"><input id="f-phone" type="tel" placeholder=" " autocomplete="tel" dir="ltr" /><label for="f-phone">{t('checkout.phone')}</label></div>
          <div class="field"><input id="f-email" type="email" placeholder=" " autocomplete="email" dir="ltr" /><label for="f-email">{t('checkout.email')}</label></div>
        </div>
      </fieldset>

      <fieldset>
        <legend class="label">02 — {t('checkout.delivery')}</legend>
        <div class="row">
          <div class="field"><input id="f-city" placeholder=" " autocomplete="address-level2" /><label for="f-city">{t('checkout.city')}</label></div>
          <div class="field"><input id="f-postal" placeholder=" " autocomplete="postal-code" dir="ltr" /><label for="f-postal">{t('checkout.postal')}</label></div>
        </div>
        <div class="field"><input id="f-address" placeholder=" " autocomplete="street-address" /><label for="f-address">{t('checkout.address')}</label></div>
        <label class="check"><input type="checkbox" /> <span>{t('checkout.gift')}</span></label>
      </fieldset>

      <fieldset>
        <legend class="label">03 — {t('checkout.payment')}</legend>
        <label class="pay">
          <input type="radio" name="pay" checked />
          <span>{t('checkout.gateway')}</span>
          <Icon name="lock" size={16} />
        </label>
      </fieldset>

      <button class="btn btn--primary btn--block co__pay" type="submit">
        <Icon name="lock" />
        {t('checkout.pay')} — <span data-co-total></span>
      </button>
      <p class="co__demo muted">{t('checkout.demo')}</p>
    </form>

    <aside class="co__sum">
      <p class="label">{t('checkout.summary')}</p>
      <ul class="co__list" role="list" data-co-list></ul>
      <p class="co__empty muted" data-co-empty hidden>
        {t('cart.empty')} <a class="link" href={href('/shop', locale)}>{t('cart.emptyCta')}</a>
      </p>
      <dl class="co__totals">
        <div><dt>{t('cart.subtotal')}</dt><dd data-co-sub></dd></div>
        <div><dt>{t('cart.shipping')}</dt><dd>{t('cart.free')}</dd></div>
        <div class="co__grand"><dt>{t('cart.total')}</dt><dd data-co-grand></dd></div>
      </dl>
    </aside>
  </div>
</BaseLayout>

<script>
  import { getCart, cartTotal, toast } from '@/scripts/cart';
  import { readCatalog, formatPriceClient } from '@/lib/catalog';

  const cat = readCatalog();
  const fmt = (n: number) => formatPriceClient(n, cat.locale);

  function render() {
    const lines = getCart();
    const list = document.querySelector<HTMLElement>('[data-co-list]')!;
    list.replaceChildren(
      ...lines.map((l) => {
        const p = cat.products[l.slug];
        const li = document.createElement('li');
        li.className = 'co__item';
        const colour = p.colourways.find((c) => c.id === l.colour)?.name ?? '';
        li.innerHTML = `<img src="${p.thumb}" alt="" width="64" height="64"><div><p class="co__name"></p><p class="co__meta"></p></div><p class="co__price"></p>`;
        li.querySelector('.co__name')!.textContent = p.name;
        li.querySelector('.co__meta')!.textContent = `${colour} × ${new Intl.NumberFormat(cat.locale === 'fa' ? 'fa-IR' : 'en-US').format(l.qty)}`;
        li.querySelector('.co__price')!.textContent = fmt(p.price * l.qty);
        return li;
      }),
    );
    const total = cartTotal(lines);
    document.querySelector('[data-co-sub]')!.textContent = fmt(total);
    document.querySelector('[data-co-grand]')!.textContent = fmt(total);
    document.querySelector('[data-co-total]')!.textContent = fmt(total);
    document.querySelector<HTMLElement>('[data-co-empty]')!.hidden = lines.length > 0;
  }
  render();
  window.addEventListener('cart:change', render);
  document.querySelector('[data-checkout]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    toast(document.querySelector('.co__demo')!.textContent ?? '');
  });
</script>

<style>
  .co {
    display: grid;
    gap: var(--s-7);
    padding-block: var(--s-6) var(--s-9);
  }
  .co__title {
    margin-block-end: var(--s-5);
  }
  .co__form {
    display: grid;
    gap: var(--s-6);
  }
  fieldset {
    border: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  legend {
    margin-block-end: var(--s-3);
  }
  .row {
    display: grid;
    gap: var(--s-3);
  }
  .field {
    position: relative;
  }
  .field input {
    width: 100%;
    height: 58px;
    padding: 22px var(--s-4) 6px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--stone-50);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--dur-fast);
  }
  .field input:focus {
    border-color: var(--ink);
  }
  .field label {
    position: absolute;
    inset-inline-start: var(--s-4);
    top: 50%;
    translate: 0 -50%;
    color: var(--stone-600);
    font-size: var(--text-sm);
    pointer-events: none;
    transition:
      top var(--dur-fast) var(--ease-out),
      font-size var(--dur-fast) var(--ease-out);
  }
  .field input:focus + label,
  .field input:not(:placeholder-shown) + label {
    top: 16px;
    font-size: var(--text-2xs);
  }
  .check,
  .pay {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .pay {
    padding: var(--s-4);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    background: var(--stone-50);
  }
  .pay span {
    flex: 1;
  }
  input[type='checkbox'],
  input[type='radio'] {
    accent-color: var(--ink);
    width: 18px;
    height: 18px;
  }
  .co__pay {
    margin-block-start: var(--s-2);
  }
  .co__demo {
    font-size: var(--text-xs);
    text-align: center;
  }
  .co__sum {
    align-self: start;
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5);
    border-radius: var(--radius);
    background: var(--stone-100);
  }
  .co__list {
    display: grid;
    gap: var(--s-4);
  }
  .co__list :global(.co__item) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--s-3);
    align-items: center;
    font-size: var(--text-sm);
  }
  .co__list :global(img) {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .co__list :global(.co__name) {
    font-weight: 500;
  }
  .co__list :global(.co__meta) {
    color: var(--stone-600);
    font-size: var(--text-xs);
  }
  .co__totals {
    display: grid;
    gap: var(--s-2);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .co__totals div {
    display: flex;
    justify-content: space-between;
  }
  .co__grand {
    font-size: var(--text-md);
    font-weight: 500;
    padding-block-start: var(--s-2);
  }
  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .co {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--s-9);
      padding-block-start: var(--s-8);
    }
    .co__sum {
      position: sticky;
      top: calc(var(--header-h) + var(--s-5));
      padding: var(--s-6);
    }
  }
</style>
