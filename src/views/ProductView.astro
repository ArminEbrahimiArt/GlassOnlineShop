---
/**
 * Product detail page.
 * Mobile: edge-to-edge swipe gallery (tap → full-screen lightbox) → info →
 *         fixed bottom buy bar with live total (app-style reference).
 * Desktop: 7-col image mosaic (click → lightbox) + 5-col sticky info column.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Hotspots from '@/components/Hotspots.astro';
import Dimensions from '@/components/Dimensions.astro';
import Placeholder from '@/components/Placeholder.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import Lightbox from '@/components/Lightbox.astro';
import { related, sizeString, type Product } from '@/data/products';
import { getCollection } from '@/data/collections';
import { formatPrice, href, localDigits, num, pick, useT, type Locale } from '@/i18n/utils';

interface Props {
  product: Product;
  locale: Locale;
}
const { product: p, locale } = Astro.props;
const t = useT(locale);
const name = pick(p.name, locale);
const coll = getCollection(p.collection)!;
const lifestyle = p.images.find((i) => i.kind === 'lifestyle');
const detail = p.images.find((i) => i.kind === 'detail') ?? p.images[p.images.length - 1];
const gallery = p.images;
const lbId = `lb-${p.slug}`;
---

<BaseLayout locale={locale} title={name} description={pick(p.description, locale)} page="product" tabbar={false} bottomBar>
  <div class="pdp container" data-product-scope data-qty-scope data-price={p.price}>
    <!-- Gallery -->
    <section class="pdp__gallery" aria-label={name}>
      <div class="pdp__track" data-track>
        {
          gallery.map((img, i) => (
            <button class:list={['pdp__shot', `pdp__shot--${img.kind}`]} style={`--stage:${p.stage}`} type="button" data-lightbox-open={lbId} data-index={i} aria-label={`${t('gallery.open')} (${i + 1}/${gallery.length})`}>
              <Image
                src={img.src}
                alt={pick(img.alt, locale)}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1024px) 58vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                format="webp"
                quality={84}
              />
              <span class="pdp__expand" aria-hidden="true">
                <Icon name="expand" size={16} />
              </span>
            </button>
          ))
        }
      </div>
      <a class="pdp__back" href={href('/shop', locale)} aria-label={t('common.back')}>
        <Icon name="arrowLeft" size={20} flip />
      </a>
      <div class="pdp__counter mono" aria-hidden="true">
        <span data-counter>{num(1, locale)}</span> / {num(gallery.length, locale)}
      </div>
      <div class="pdp__dots" aria-hidden="true">
        {gallery.map((_, i) => <span class:list={{ 'is-active': i === 0 }} data-dot={i} />)}
      </div>
    </section>

    <!-- Info -->
    <section class="pdp__info">
      <div class="pdp__sticky">
        <nav class="pdp__crumbs label" aria-label="Breadcrumb">
          <a href={href('/shop', locale)}>{t('product.breadcrumb')}</a>
          <span aria-hidden="true">/</span>
          <a href={href('/collections', locale) + `#${coll.slug}`}>{pick(coll.name, locale)}</a>
        </nav>

        <div class="pdp__titles">
          <h1 class="t-h1">{name}</h1>
          <p class="t-lead muted">{pick(p.tagline, locale)}</p>
        </div>

        <div class="pdp__priceRow">
          <div>
            <p class="pdp__price">{formatPrice(p.price, locale)}</p>
            <p class="mono muted">{p.code}</p>
          </div>
          <div class="qty" role="group" aria-label={t('cart.qty')}>
            <button type="button" data-qty-step="-1" aria-label="−"><Icon name="minus" size={16} /></button>
            <span data-qty-value="1" aria-live="polite">{num(1, locale)}</span>
            <button type="button" data-qty-step="1" aria-label="+"><Icon name="plus" size={16} /></button>
          </div>
        </div>

        <fieldset class="pdp__colours">
          <legend class="label">
            {t('common.colour')} <span class="muted">— <span data-colour-label>{pick(p.colourways[0].name, locale)}</span></span>
          </legend>
          <div class="pdp__swatches">
            {
              p.colourways.map((c, i) => (
                <label class="swatch" title={pick(c.name, locale)}>
                  <input type="radio" name="colour" value={c.id} checked={i === 0} data-name={pick(c.name, locale)} />
                  <span class="swatch__dot" style={`background:${c.swatch}`} />
                  <span class="visually-hidden">{pick(c.name, locale)}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="pdp__size">
          <span class="label">{t('product.frameSize')}</span>
          <span class="mono">{localDigits(sizeString(p), locale)}</span>
        </div>

        <div class="pdp__ctas">
          <button class="btn btn--primary btn--block pdp__add" type="button" data-add-to-cart data-use-qty data-slug={p.slug}>
            <Icon name="bag" size={18} />
            {t('common.addToBag')}
          </button>
          <button class="btn btn--ghost btn--block" type="button" data-tryon-open data-slug={p.slug}>
            <Icon name="mirror" size={18} />
            {t('product.tryOnCta')}
          </button>
        </div>

        <ul class="pdp__assure t-small" role="list">
          <li><Icon name="truck" size={18} /> {t('product.inStock')}</li>
          <li><Icon name="hand" size={18} /> {t('product.handmade', { n: num(p.hours, locale) })} · {t('common.limited')} {t('common.pieces', { n: num(p.run, locale) })}</li>
          <li><Icon name="shield" size={18} /> {t('product.acc.care')}</li>
        </ul>

        <p class="t-body">{pick(p.description, locale)}</p>

        <div class="acc">
          <details open>
            <summary>{t('product.acc.details')}<Icon name="plus" size={18} /></summary>
            <dl class="acc__dl">
              <div><dt class="muted">{t('product.material')}</dt><dd>{pick(p.material, locale)}</dd></div>
              <div><dt class="muted">{t('product.lens')}</dt><dd>{pick(p.lens, locale)}</dd></div>
              <div><dt class="muted">{t('product.weight')}</dt><dd>{localDigits(`${p.weight} g`, locale)}</dd></div>
              <div><dt class="muted">{t('product.codeLabel')}</dt><dd class="mono">{p.code}</dd></div>
            </dl>
          </details>
          <details>
            <summary>{t('product.acc.fit')}<Icon name="plus" size={18} /></summary>
            <p>{t('product.fitBody')}</p>
          </details>
          <details>
            <summary>{t('product.acc.shipping')}<Icon name="plus" size={18} /></summary>
            <p>{t('product.shippingBody')}</p>
          </details>
          <details>
            <summary>{t('product.acc.care')}<Icon name="plus" size={18} /></summary>
            <p>{t('product.careBody')}</p>
          </details>
        </div>
      </div>
    </section>
  </div>

  <!-- Anatomy -->
  <section class="section container">
    <SectionHead kicker={t('product.craft.kicker')} title={t('product.craft.title')} />
    <div data-reveal>
      <Hotspots image={p.anatomy.image} alt={pick(p.anatomy.alt, locale)} spots={p.anatomy.spots} locale={locale} id={`hs-${p.slug}`} />
    </div>
  </section>

  <!-- Lifestyle + detail inset -->
  <section class="life" data-reveal>
    {
      lifestyle ? (
        <Image src={lifestyle.src} alt={pick(lifestyle.alt, locale)} widths={[640, 1000, 1600, 2000]} sizes="100vw" class="life__img" format="webp" />
      ) : (
        <Placeholder label={t('common.placeholder')} caption="Campaign / lifestyle" ratio="16 / 9" variant="arc" tone="#ddd7cf" class="life__ph" />
      )
    }
    <div class="life__inset">
      <Image src={detail.src} alt={pick(detail.alt, locale)} widths={[300, 500, 700]} sizes="(min-width: 1024px) 22vw, 40vw" format="webp" />
    </div>
  </section>

  <!-- Measurements -->
  <section class="section container">
    <SectionHead kicker={t('product.dims.kicker')} title={t('product.dims.title')} />
    <div data-reveal>
      <Dimensions product={p} locale={locale} />
    </div>
  </section>

  <!-- Try-on band -->
  <section class="container">
    <div class="tryband" data-reveal>
      <div>
        <p class="label tryband__k">{t('mirror.title')}</p>
        <p class="t-h3">{t('product.tryOnCta')}</p>
      </div>
      <button class="btn btn--light" type="button" data-tryon-open data-slug={p.slug} data-autostart>
        <Icon name="camera" size={18} />
        {t('home.mirror.cta')}
      </button>
    </div>
  </section>

  <!-- Related -->
  <section class="section container">
    <SectionHead title={t('product.related')} action={{ href: href('/shop', locale), label: t('common.viewAll') }} />
    <div class="related">
      {related(p.slug).map((r, i) => <ProductCard product={r} locale={locale} i={i} />)}
    </div>
  </section>

  <!-- Mobile bottom buy bar (always visible < 1024px) -->
  <div class="buybar" data-product-scope>
    <div class="buybar__info">
      <p class="label muted">{t('common.total')}</p>
      <p class="buybar__price" data-total>{formatPrice(p.price, locale)}</p>
    </div>
    <button class="buybar__try" type="button" data-tryon-open data-slug={p.slug} aria-label={t('common.tryOn')}>
      <Icon name="mirror" size={20} />
    </button>
    <button class="btn btn--primary buybar__btn" type="button" data-add-to-cart data-use-qty data-slug={p.slug} data-buybar-add>
      {t('common.addToBag')}
      <Icon name="bag" size={18} />
    </button>
  </div>

  <Lightbox id={lbId} images={gallery.map((g) => ({ src: g.src, alt: pick(g.alt, locale) }))} locale={locale} />
</BaseLayout>

<script>
  const lang = document.documentElement.lang === 'fa' ? 'fa-IR' : 'en-US';
  const fmt = new Intl.NumberFormat(lang);

  // Gallery counter + dots (mobile swipe track)
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (track) {
    const shots = [...track.children] as HTMLElement[];
    const counter = document.querySelector('[data-counter]');
    const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting && e.intersectionRatio > 0.6) {
            const i = shots.indexOf(e.target as HTMLElement);
            if (counter) counter.textContent = fmt.format(i + 1);
            dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
          }
        }
      },
      { root: track, threshold: [0.6] },
    );
    shots.forEach((s) => io.observe(s));
  }

  // Quantity stepper → live total in the buy bar
  const pdp = document.querySelector<HTMLElement>('.pdp')!;
  const price = Number(pdp.dataset.price);
  const qtyEl = pdp.querySelector<HTMLElement>('[data-qty-value]')!;
  const total = document.querySelector('[data-total]');
  const suffix = lang === 'fa-IR' ? ' تومان' : ' Toman';
  pdp.querySelectorAll<HTMLElement>('[data-qty-step]').forEach((b) =>
    b.addEventListener('click', () => {
      const q = Math.min(9, Math.max(1, Number(qtyEl.dataset.qtyValue) + Number(b.dataset.qtyStep)));
      qtyEl.dataset.qtyValue = String(q);
      qtyEl.textContent = fmt.format(q);
      if (total) total.textContent = fmt.format(price * q) + suffix;
    }),
  );

  // Colour swatches → label, measurement render, buy-bar colour
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="colour"]');
  const label = document.querySelector('[data-colour-label]');
  radios.forEach((r) =>
    r.addEventListener('change', () => {
      if (label) label.textContent = r.dataset.name ?? '';
      document.querySelectorAll<HTMLElement>('[data-frame-for]').forEach((el) => (el.hidden = el.dataset.frameFor !== r.value));
      document.querySelectorAll<HTMLElement>('.buybar [data-add-to-cart], .buybar [data-tryon-open]').forEach((b) => (b.dataset.colour = r.value));
    }),
  );
</script>

<style>
  /* ── Layout ── */
  .pdp {
    display: grid;
    padding-inline: 0;
  }

  /* ── Gallery ── */
  .pdp__gallery {
    position: relative;
  }
  .pdp__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .pdp__track::-webkit-scrollbar {
    display: none;
  }
  .pdp__shot {
    position: relative;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5;
    background: var(--stage);
    overflow: hidden;
    cursor: zoom-in;
  }
  .pdp__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .pdp__expand {
    position: absolute;
    bottom: var(--s-3);
    inset-inline-end: var(--s-3);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity var(--dur-fast);
  }
  .pdp__back,
  .pdp__counter {
    position: absolute;
    top: var(--s-3);
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(6px);
    border-radius: var(--radius-xs);
  }
  .pdp__back {
    inset-inline-start: var(--s-3);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
  }
  .pdp__counter {
    inset-inline-end: var(--s-3);
    padding: 6px 10px;
  }
  .pdp__dots {
    position: absolute;
    bottom: var(--s-4);
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    pointer-events: none;
  }
  .pdp__dots span {
    width: 6px;
    height: 2px;
    background: rgb(20 19 18 / 0.25);
    transition:
      width var(--dur) var(--ease-out),
      background-color var(--dur);
  }
  .pdp__dots span.is-active {
    width: 20px;
    background: var(--ink);
  }

  /* ── Info ── */
  .pdp__info {
    padding: var(--s-6) var(--gutter) 0;
  }
  .pdp__sticky {
    display: grid;
    gap: var(--s-6);
  }
  .pdp__crumbs {
    display: flex;
    gap: var(--s-2);
    color: var(--stone-600);
  }
  .pdp__crumbs a:hover {
    color: var(--ink);
  }
  .pdp__titles {
    display: grid;
    gap: var(--s-3);
    margin-block-start: calc(-1 * var(--s-3));
  }
  .pdp__priceRow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
  }
  .pdp__price {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
  }
  .qty button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 100%;
    transition: background-color var(--dur-fast);
  }
  .qty button:hover {
    background: var(--stone-100);
  }
  .qty span {
    min-width: 2.5ch;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .pdp__colours {
    border: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .pdp__swatches {
    display: flex;
    gap: var(--s-3);
  }
  .swatch {
    cursor: pointer;
  }
  .swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .swatch__dot {
    display: block;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
    outline: 1px solid transparent;
    outline-offset: 3px;
    transition: outline-color var(--dur-fast);
  }
  .swatch input:checked + .swatch__dot {
    outline-color: var(--ink);
  }
  .swatch input:focus-visible + .swatch__dot {
    outline: 2px solid var(--nude-500);
  }
  .pdp__size {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-start: calc(-1 * var(--s-2));
  }
  .pdp__ctas {
    display: grid;
    gap: var(--s-2);
  }
  .pdp__assure {
    display: grid;
    gap: var(--s-3);
    color: var(--stone-600);
  }
  .pdp__assure li {
    display: flex;
    gap: var(--s-3);
    align-items: center;
  }

  .acc {
    border-block-start: 1px solid var(--line);
  }
  .acc details {
    border-block-end: 1px solid var(--line);
  }
  .acc summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 56px;
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .acc summary::-webkit-details-marker {
    display: none;
  }
  .acc summary :global(.icon) {
    transition: transform var(--dur) var(--ease-out);
  }
  .acc details[open] summary :global(.icon) {
    transform: rotate(45deg);
  }
  .acc details > :not(summary) {
    padding-block-end: var(--s-5);
    font-size: var(--text-sm);
    color: var(--stone-600);
    max-width: var(--measure);
  }
  .acc__dl {
    display: grid;
    gap: var(--s-2);
  }
  .acc__dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s-3);
  }
  .acc__dl dd {
    color: var(--ink);
  }

  @media (max-width: 1023px) {
    /* the bottom buy bar carries "Add to bag" on mobile */
    .pdp__add {
      display: none;
    }
  }
  @media (min-width: 1024px) {
    .pdp {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--s-9);
      padding-inline: var(--gutter);
      padding-block-start: var(--s-5);
    }
    .pdp__track {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-2);
      overflow: visible;
    }
    .pdp__shot {
      border-radius: var(--radius);
    }
    .pdp__shot:first-child,
    .pdp__shot:last-child:nth-child(even) {
      grid-column: 1 / -1;
      aspect-ratio: 5 / 4;
    }
    .pdp__shot:hover img {
      transform: scale(1.02);
    }
    .pdp__shot:hover .pdp__expand {
      opacity: 1;
    }
    .pdp__back,
    .pdp__counter,
    .pdp__dots {
      display: none;
    }
    .pdp__info {
      padding: 0;
    }
    .pdp__sticky {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
      padding-block-end: var(--s-7);
    }
  }

  /* ── Lifestyle ── */
  .life {
    position: relative;
  }
  .life__img {
    width: 100%;
    height: min(90svh, 900px);
    object-fit: cover;
    object-position: 50% 30%;
  }
  .life :global(.life__ph) {
    border-radius: 0;
    aspect-ratio: auto;
    height: min(70svh, 760px);
  }
  .life__inset {
    position: absolute;
    inset-inline-end: var(--gutter);
    bottom: var(--gutter);
    width: clamp(120px, 26vw, 320px);
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 4px solid var(--paper);
    box-shadow: var(--shadow-float);
  }
  .life__inset img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Try-on band ── */
  .tryband {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    padding: var(--s-7) var(--s-6);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--paper);
  }
  .tryband__k {
    color: var(--nude-300);
    margin-block-end: var(--s-2);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) var(--grid-gap);
  }
  .related > :global(:nth-child(3)) {
    display: none;
  }
  @media (min-width: 1024px) {
    .related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .related > :global(:nth-child(3)) {
      display: block;
    }
  }

  /* ── Mobile buy bar (reference: total + primary action) ── */
  .buybar {
    position: fixed;
    z-index: 40;
    inset-inline: var(--s-3);
    bottom: calc(var(--s-3) + env(safe-area-inset-bottom));
    height: var(--tabbar-h);
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding-inline: var(--s-4) var(--s-2);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--white) 92%, transparent);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-float);
  }
  .buybar__info {
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }
  .buybar__info .label {
    font-size: 10px;
  }
  .buybar__price {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    white-space: nowrap;
  }
  .buybar__try {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--line-strong);
  }
