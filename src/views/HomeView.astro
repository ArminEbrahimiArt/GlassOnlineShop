---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Hotspots from '@/components/Hotspots.astro';
import Placeholder from '@/components/Placeholder.astro';
import SectionHead from '@/components/SectionHead.astro';
import { products, getProduct, type Product } from '@/data/products';
import { collections, getCollection } from '@/data/collections';
import { process } from '@/data/editorial';
import { formatPrice, href, num, pick, useT, type Locale } from '@/i18n/utils';

import milanoCampaign from '@/assets/products/milano/campaign.jpg';
import milanoMan from '@/assets/products/milano/portrait-man.jpg';
import notteStill from '@/assets/products/notte/still-life.jpg';
import notteAngle from '@/assets/products/notte/angle.jpg';
import cristalloFloat from '@/assets/products/cristallo/float.jpg';
import cristalloAngle from '@/assets/products/cristallo/angle.jpg';
import rosaAngle from '@/assets/products/rosa/angle.jpg';
import rosaStanding from '@/assets/products/rosa/standing.jpg';
import womanPortrait from '@/assets/products/milano/portrait-woman.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const n2 = (i: number) => num(i, locale).padStart(2, locale === 'fa' ? '۰' : '0');

/* Hero slides — art-directed: a landscape-friendly crop for desktop and a
   portrait image for phones, both of the same product. */
interface Slide {
  product: Product;
  desktop: ImageMetadata;
  dPos: string;
  mobile: ImageMetadata;
  mPos: string;
}
const slides: Slide[] = [
  { product: getProduct('milano')!, desktop: milanoCampaign, dPos: '50% 60%', mobile: milanoMan, mPos: '45% 30%' },
  { product: getProduct('notte')!, desktop: notteStill, dPos: '50% 55%', mobile: notteAngle, mPos: '50% 40%' },
  { product: getProduct('cristallo')!, desktop: cristalloFloat, dPos: '50% 50%', mobile: cristalloFloat, mPos: '50% 40%' },
  { product: getProduct('rosa')!, desktop: rosaAngle, dPos: '50% 55%', mobile: rosaStanding, mPos: '50% 40%' },
];
const heroImages = await Promise.all(
  slides.map(async (s) => {
    const d = await getImage({ src: s.desktop, widths: [1024, 1440, 1920], format: 'webp', quality: 82 });
    const m = await getImage({ src: s.mobile, widths: [480, 720, 960], format: 'webp', quality: 80 });
    return { d, m };
  }),
);

const notte = getProduct('notte')!;
const collectionImages: Record<string, ImageMetadata> = {
  riviera: cristalloAngle,
  notturno: notteAngle,
  atelier: rosaStanding,
};
---

<BaseLayout locale={locale} overlayHeader page="home">
  <!-- ── 1. Hero: full-bleed slideshow + glass caption panel ─────────── -->
  <section class="hero" data-hero aria-roledescription="carousel" aria-label={t('home.featured.kicker')}>
    <div class="hero__media">
      {
        slides.map((s, i) => (
          <picture class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : undefined}>
            <source media="(min-width: 900px)" srcset={heroImages[i].d.srcSet.attribute} sizes="100vw" />
            <img
              class="hero__img"
              src={heroImages[i].m.src}
              srcset={heroImages[i].m.srcSet.attribute}
              sizes="100vw"
              alt={pick(s.product.images[0].alt, locale)}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              style={`--d-pos:${s.dPos};--m-pos:${s.mPos}`}
            />
          </picture>
        ))
      }
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>

    <div class="hero__frame container">
      <div class="panel">
        <div class="panel__top">
          <p class="label panel__kicker">{t('home.hero.kicker')}</p>
          <div class="panel__nav">
            <span class="mono panel__count"><span data-hero-index>{n2(1)}</span> / {n2(slides.length)}</span>
            <button class="panel__arrow" type="button" data-hero-prev aria-label={t('common.prev')}>
              <Icon name="chevronLeft" size={18} flip />
            </button>
            <button class="panel__arrow" type="button" data-hero-next aria-label={t('common.next')}>
              <Icon name="chevronRight" size={18} flip />
            </button>
          </div>
        </div>

        <h1 class="t-h1 panel__title">
          <span>{t('home.hero.title')}</span>
          <span class="panel__title-2">{t('home.hero.title2')}</span>
        </h1>

        <div class="panel__product" aria-live="polite">
          {
            slides.map((s, i) => (
              <a class:list={['panel__item', { 'is-active': i === 0 }]} href={href(`/product/${s.product.slug}`, locale)} data-slide-info tabindex={i === 0 ? undefined : '-1'}>
                <span class="panel__name">{pick(s.product.name, locale)}</span>
                <span class="panel__dash" aria-hidden="true" />
                <span class="muted">{formatPrice(s.product.price, locale)}</span>
                <Icon name="arrowUpRight" size={16} class="panel__go flip-rtl" />
              </a>
            ))
          }
        </div>

        <div class="panel__ctas">
          <a class="btn btn--primary" href={href('/shop', locale)}>
            {t('home.hero.cta')}
            <Icon name="arrow" size={18} flip />
          </a>
          <button class="btn btn--ghost panel__try" type="button" data-tryon-open data-hero-try aria-label={t('home.hero.cta2')}>
            <Icon name="mirror" size={18} />
            <span class="panel__try-label">{t('home.hero.cta2')}</span>
          </button>
        </div>

        <div class="panel__progress" role="tablist">
          {
            slides.map((s, i) => (
              <button class:list={['panel__tab', { 'is-active': i === 0 }]} type="button" role="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={pick(s.product.name, locale)}>
                <span />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ── 2. Statement ────────────────────────────────────────────────── -->
  <section class="section container">
    <div class="grid-12 statement">
      <p class="label muted statement__k" data-reveal>{t('home.statement.kicker')}</p>
      <p class="statement__text" data-reveal>
        {
          t('home.statement', { n: '§' })
            .split('§')
            .map((part, i) => (i === 0 ? part : [<span class="accent">{num(40, locale)}</span>, part]))
        }
      </p>
    </div>
  </section>

  <!-- ── 3. Product scenes (one per screen) ──────────────────────────── -->
  <section class="scenes" aria-labelledby="featured-title">
    <div class="container">
      <SectionHead kicker={t('home.featured.kicker')} title={t('home.featured.title')} action={{ href: href('/shop', locale), label: t('common.viewAll') }} />
    </div>

    {
      products.map((p, i) => (
        <article class:list={['scene', { 'scene--flip': i % 2 === 1 }]} data-scene data-product-scope>
          <div class="container grid-12 scene__inner">
            <div class="scene__gallery" data-reveal>
              <a class="scene__main" style={`--stage:${p.stage}`} href={href(`/product/${p.slug}`, locale)} aria-label={pick(p.name, locale)}>
                {p.images.map((img, j) => (
                  <Image
                    src={img.src}
                    alt={pick(img.alt, locale)}
                    widths={[480, 800, 1200, 1600]}
                    sizes="(min-width: 1024px) 58vw, 100vw"
                    class:list={['scene__img', { 'is-active': j === 0 }]}
                    data-scene-img={j}
                    loading="lazy"
                    format="webp"
                  />
                ))}
              </a>
              {p.images.length > 1 && (
                <div class="scene__thumbs" role="tablist" aria-label={pick(p.name, locale)}>
                  {p.images.map((img, j) => (
                    <button type="button" class:list={['scene__thumb', { 'is-active': j === 0 }]} data-scene-thumb={j} aria-label={pick(img.alt, locale)}>
                      <Image src={img.src} alt="" width={128} height={128} format="webp" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>

            <div class="scene__info" data-reveal>
              <p class="label muted">
                <span class="mono">
                  {n2(i + 1)} / {n2(products.length)}
                </span>
                <span aria-hidden="true"> · </span>
                {pick(getCollection(p.collection)!.name, locale)}
              </p>
              <h3 class="t-display scene__name">{pick(p.name, locale)}</h3>
              <p class="t-lead">{pick(p.tagline, locale)}</p>
              <p class="t-small muted">{formatPrice(p.price, locale)}</p>
              <div class="scene__actions">
                <a class="scene__circle" href={href(`/product/${p.slug}`, locale)} aria-label={t('common.details')}>
                  <Icon name="info" />
                </a>
                <button class="btn btn--primary scene__buy" type="button" data-add-to-cart data-slug={p.slug}>
                  <Icon name="bag" size={18} />
                  {t('common.buy')}
                </button>
                <button class="scene__circle" type="button" data-tryon-open data-slug={p.slug} aria-label={t('common.tryOn')}>
                  <Icon name="mirror" />
                </button>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ── 4. Anatomy / hotspots ───────────────────────────────────────── -->
  <section class="section container">
    <SectionHead kicker={t('home.craft.kicker')} title={t('home.craft.title')} lead={t('home.craft.body')} />
    <div data-reveal>
      <Hotspots image={notte.anatomy.image} alt={pick(notte.anatomy.alt, locale)} spots={notte.anatomy.spots} locale={locale} id="home-hs" />
    </div>
  </section>

  <!-- ── 5. Virtual Mirror CTA ───────────────────────────────────────── -->
  <section class="mirror-cta">
    <div class="container grid-12 mirror-cta__inner">
      <div class="mirror-cta__visual" data-reveal>
        <Image src={womanPortrait} alt="" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 40vw, 100vw" class="mirror-cta__img" format="webp" />
        <div class="mirror-cta__ui" aria-hidden="true">
          <span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span>
          <span class="mirror-cta__scan"></span>
          <span class="mirror-cta__chip mono">● LIVE · 478 PTS</span>
        </div>
      </div>
      <div class="mirror-cta__text">
        <SectionHead kicker={t('home.mirror.kicker')} title={t('home.mirror.title')} lead={t('home.mirror.body')} tone="paper" />
        <div data-reveal class="mirror-cta__actions">
          <button class="btn btn--light" type="button" data-tryon-open data-autostart>
            <Icon name="camera" size={18} />
            {t('home.mirror.cta')}
          </button>
          <p class="t-caption mirror-cta__note"><Icon name="lock" size={14} /> {t('home.mirror.note')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. Collections rail ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <SectionHead kicker={t('home.collections.kicker')} title={t('home.collections.title')} action={{ href: href('/collections', locale), label: t('common.viewAll') }} />
    </div>
    <ul class="rail" role="list">
      {
        collections.map((c, i) => (
          <li class="rail__item" data-reveal style={`--reveal-i:${i}`}>
            <a href={href('/collections', locale) + `#${c.slug}`} class="coll">
              {collectionImages[c.slug] ? (
                <div class="coll__media">
                  <Image src={collectionImages[c.slug]} alt="" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, 80vw" class="coll__img" format="webp" />
                </div>
              ) : (
                <Placeholder label={t('common.comingSoon')} caption={t('common.placeholder')} tone={c.tone} variant="arc" ratio="4 / 5" />
              )}
              <div class="coll__info">
                <p class="label muted">{pick(c.season, locale)}</p>
                <h3 class="t-h3">{pick(c.name, locale)}</h3>
                <p class="t-small muted">{pick(c.story, locale)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── 7. Atelier teaser ───────────────────────────────────────────── -->
  <section class="section container">
    <div class="grid-12 atelier">
      <div class="atelier__media" data-reveal>
        <Placeholder label={t('nav.atelier')} caption={t('common.placeholder')} variant="lines" ratio="4 / 5" tone="#e3ddd4" />
      </div>
      <div class="atelier__text">
        <SectionHead kicker={t('home.atelier.kicker')} title={t('home.atelier.title')} />
        <ol class="atelier__steps" role="list" data-reveal>
          {
            process.slice(0, 4).map((s) => (
              <li>
                <span class="mono muted">{locale === 'fa' ? num(Number(s.n), 'fa').padStart(2, '۰') : s.n}</span>
                <div>
                  <p class="atelier__step-title">{pick(s.title, locale)}</p>
                  <p class="t-small muted">{pick(s.body, locale)}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <a class="btn btn--ghost atelier__cta" href={href('/atelier', locale)} data-reveal>
          {t('home.atelier.cta')}
          <Icon name="arrow" size={18} flip />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* Hero: auto-advancing crossfade. Progress segments, arrows, swipe, keyboard. */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const infos = [...hero.querySelectorAll<HTMLElement>('[data-slide-info]')];
    const tabs = [...hero.querySelectorAll<HTMLElement>('[data-tab]')];
    const index = hero.querySelector('[data-hero-index]');
    const tryBtn = hero.querySelector<HTMLElement>('[data-hero-try]');
    const slugs = infos.map((a) => a.getAttribute('href')!.replace(/\/$/, '').split('/').pop()!);
    const fmt = new Intl.NumberFormat(document.documentElement.lang === 'fa' ? 'fa-IR' : 'en-US', { minimumIntegerDigits: 2 });
    const DURATION = 6500;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;

    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i);
        s.toggleAttribute('aria-hidden', k !== i);
      });
      infos.forEach((a, k) => {
        a.classList.toggle('is-active', k === i);
        a.tabIndex = k === i ? 0 : -1;
      });
      tabs.forEach((t, k) => {
        t.classList.remove('is-active');
        t.classList.toggle('is-done', k < i);
        t.setAttribute('aria-selected', String(k === i));
      });
      void tabs[i].offsetWidth; // restart the CSS progress animation
      tabs[i].classList.add('is-active');
      if (index) index.textContent = fmt.format(i + 1).replace(/[,٬]/g, '');
      if (tryBtn) tryBtn.dataset.slug = slugs[i];
      clearTimeout(timer);
      if (!reduce) timer = window.setTimeout(() => go(i + 1), DURATION);
    };
    hero.style.setProperty('--hero-dur', `${DURATION}ms`);
    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => go(i - 1));
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => go(i + 1));
    hero.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      if (e.key === 'ArrowRight') go(i + (rtl ? -1 : 1));
      if (e.key === 'ArrowLeft') go(i + (rtl ? 1 : -1));
    });
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const rtl = document.documentElement.dir === 'rtl';
      if (Math.abs(dx) > 50) go(i + ((dx < 0) !== rtl ? 1 : -1));
      x0 = null;
    });
    go(0);
  }

  /* Scenes: thumbnails swap the main image (hover on desktop, tap on touch). */
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((scene) => {
    const imgs = scene.querySelectorAll<HTMLElement>('[data-scene-img]');
    const thumbs = scene.querySelectorAll<HTMLElement>('[data-scene-thumb]');
    const show = (n: number) => {
      imgs.forEach((im, k) => im.classList.toggle('is-active', k === n));
      thumbs.forEach((t, k) => t.classList.toggle('is-active', k === n));
    };
    thumbs.forEach((t, k) => {
      t.addEventListener('mouseenter', () => show(k));
      t.addEventListener('click', () => show(k));
    });
  });
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: calc(100svh - var(--announce-h));
    min-height: 600px;
    max-height: 1080px;
    overflow: hidden;
    background: var(--stone-200);
    isolation: isolate;
  }
  .hero__media,
  .hero__slide {
    position: absolute;
    inset: 0;
  }
  .hero__slide {
    opacity: 0;
    transition: opacity 1.4s var(--ease-in-out);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--m-pos);
    transform: scale(1.06);
    transition: transform 8s linear;
  }
  .hero__slide.is-active .hero__img {
    transform: scale(1);
  }
  @media (min-width: 900px) {
    .hero__img {
      object-position: var(--d-pos);
    }
  }
  /* Soft scrim so the overlaid header stays legible on any image. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--paper) 55%, transparent) 0,
      transparent calc(var(--header-h) * 2.2)
    );
    pointer-events: none;
  }

  .hero__frame {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    padding-block-end: var(--gutter);
  }

  /* Glass caption panel — the hero's text component */
  .panel {
    position: relative;
    width: 100%;
    min-width: 0;
    display: grid;
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-5);
    background: color-mix(in oklab, var(--paper) 74%, transparent);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    border: 1px solid color-mix(in oklab, var(--white) 55%, transparent);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.4) inset, 0 24px 48px -24px rgb(20 19 18 / 0.25);
    overflow: hidden;
  }
  .panel__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }
  .panel__kicker {
    display: none;
  }
  @media (min-width: 600px) {
    .panel__kicker {
      display: block;
    }
  }
  .panel__top {
    justify-content: space-between;
  }
  .panel__nav {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: var(--s-1);
    flex: none;
  }
  .panel__count {
    margin-inline-end: var(--s-2);
    color: var(--stone-600);
  }
  .panel__arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--line);
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .panel__arrow:hover {
    border-color: var(--ink);
    background: color-mix(in oklab, var(--white) 50%, transparent);
  }
  .panel__title {
    display: grid;
  }
  .panel__title-2 {
    color: var(--stone-600);
  }
  .panel__product {
    display: grid;
    padding-block: var(--s-3);
    border-block: 1px solid var(--line);
  }
  .panel__item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--text-sm);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }
  .panel__item.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .panel__name {
    font-weight: 500;
  }
  .panel__dash {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
    max-width: 4rem;
  }
  .panel__item :global(.panel__go) {
    margin-inline-start: auto;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .panel__item:hover :global(.panel__go) {
    transform: translate(2px, -2px);
  }
  .panel__ctas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-2);
  }
  .panel__try {
    width: var(--btn-h);
    padding-inline: 0 !important;
  }
  .panel__try-label {
    display: none;
  }
  .panel__title {
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 4rem);
  }
  @media (min-width: 600px) {
    .panel__ctas {
      grid-template-columns: 1fr 1fr;
    }
    .panel__try {
      width: auto;
      padding-inline: var(--s-3) !important;
    }
    .panel__try-label {
      display: inline;
    }
  }
  .panel__ctas .btn {
    padding-inline: var(--s-3);
  }
  .panel__ctas .btn--ghost {
    background: color-mix(in oklab, var(--white) 35%, transparent);
  }
  .panel__progress {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 2px;
  }
  .panel__tab {
    position: relative;
    height: 12px;
    display: flex;
    align-items: flex-end;
  }
  .panel__tab span {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .panel__tab span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) .panel__tab span::after {
    transform-origin: right;
  }
