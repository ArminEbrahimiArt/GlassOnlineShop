---
/**
 * Home — image-led. Order:
 *  1. Hero: full-bleed art-directed slideshow; only two buttons per slide
 *  2. New season: the headline + the product grid (shopping starts here)
 *  3. Lookbook: on-model portraits
 *  4. Up close: anatomy hotspots
 *  5. Virtual Mirror
 *  6. Collections rail
 *  7. Atelier band
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Hotspots from '@/components/Hotspots.astro';
import Placeholder from '@/components/Placeholder.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProductCard from '@/components/ProductCard.astro';
import { products, getProduct } from '@/data/products';
import { collections } from '@/data/collections';
import { media } from '@/lib/media';
import { href, pick, useT, type Locale } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const heroProducts = products.filter((p) => p.hero);
const heroImages = await Promise.all(
  heroProducts.map(async (p) => ({
    d: await getImage({ src: p.hero!.desktop, widths: [1024, 1440, 1920], format: 'webp', quality: 82 }),
    m: await getImage({ src: p.hero!.mobile, widths: [540, 810, 1080], format: 'webp', quality: 80 }),
  })),
);

const milano = getProduct('milano')!;
const notte = getProduct('notte')!;
const collectionImages: Record<string, ImageMetadata> = {
  riviera: media('cristallo', 'hero-mobile'),
  notturno: media('notte', 'hero-mobile'),
  atelier: media('rosa', 'gallery-2'),
};
---

<BaseLayout locale={locale} overlayHeader page="home">
  <!-- ── 1. Hero ──────────────────────────────────────────────────────── -->
  <section class="hero" data-hero aria-roledescription="carousel" aria-label={t('home.featured.kicker')}>
    {
      heroProducts.map((p, i) => (
        <div class:list={['hero__slide', { 'is-active': i === 0 }]} data-slide aria-hidden={i !== 0 ? 'true' : undefined}>
          <picture>
            <source media="(min-width: 900px)" srcset={heroImages[i].d.srcSet.attribute} sizes="100vw" />
            <img
              class="hero__img"
              src={heroImages[i].m.src}
              srcset={heroImages[i].m.srcSet.attribute}
              sizes="100vw"
              alt={pick(p.images[0].alt, locale)}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
            />
          </picture>
          <div class="hero__actions">
            <a class="btn btn--primary hero__btn" href={href(`/product/${p.slug}`, locale)} tabindex={i === 0 ? undefined : '-1'}>
              {t('home.hero.discover', { name: pick(p.name, locale) })}
            </a>
            <button class="btn hero__btn hero__btn--glass" type="button" data-tryon-open data-slug={p.slug} tabindex={i === 0 ? undefined : '-1'}>
              <Icon name="mirror" size={16} />
              {t('common.tryOn')}
            </button>
          </div>
        </div>
      ))
    }
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__dots" role="tablist">
      {
        heroProducts.map((p, i) => (
          <button class:list={['hero__dot', { 'is-active': i === 0 }]} type="button" role="tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={pick(p.name, locale)}>
            <span />
          </button>
        ))
      }
    </div>
  </section>

  <!-- ── 2. New season: headline + products ──────────────────────────── -->
  <section class="section container">
    <SectionHead
      kicker={t('home.hero.kicker')}
      title={`${t('home.hero.title')} ${t('home.hero.title2')}`}
      action={{ href: href('/shop', locale), label: t('common.viewAll') }}
    />
    <div class="products">
      {products.map((p, i) => <ProductCard product={p} locale={locale} i={i} eager={i < 2} />)}
    </div>
  </section>

  <!-- ── 3. Lookbook ───────────────────────────────────────────────────── -->
  <section class="lookbook" aria-label={t('home.lookbook.title')}>
    {
      milano.lifestyle.map((img, i) => (
        <a class="look" href={href(`/product/${milano.slug}`, locale)} data-reveal style={`--reveal-i:${i}`}>
          <Image src={img.src} alt={pick(img.alt, locale)} widths={[480, 720, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="look__img" format="webp" />
          <span class="look__cap">
            <span class="label">{t('home.lookbook.title')}</span>
            <span class="look__name">
              {pick(milano.name, locale)}
              <Icon name="arrowUpRight" size={16} class="flip-rtl" />
            </span>
          </span>
        </a>
      ))
    }
  </section>

  <!-- ── 4. Up close ───────────────────────────────────────────────────── -->
  <section class="section container">
    <SectionHead kicker={t('home.craft.kicker')} title={t('home.craft.title')} />
    <div data-reveal>
      <Hotspots image={notte.anatomy.image} alt={pick(notte.anatomy.alt, locale)} spots={notte.anatomy.spots} locale={locale} id="home-hs" />
    </div>
  </section>

  <!-- ── 5. Virtual Mirror ─────────────────────────────────────────────── -->
  <section class="mirror-cta">
    <div class="container grid-12 mirror-cta__inner">
      <div class="mirror-cta__visual" data-reveal>
        <Image src={media('milano', 'lifestyle-1')} alt="" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 40vw, 100vw" class="mirror-cta__img" format="webp" />
        <div class="mirror-cta__ui" aria-hidden="true">
          <span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span><span class="mirror-cta__corner"></span>
          <span class="mirror-cta__scan"></span>
        </div>
      </div>
      <div class="mirror-cta__text">
        <SectionHead kicker={t('home.mirror.kicker')} title={t('home.mirror.title')} lead={t('home.mirror.body')} tone="paper" />
        <div data-reveal class="mirror-cta__actions">
          <button class="btn btn--light" type="button" data-tryon-open data-autostart>
            <Icon name="camera" size={16} />
            {t('home.mirror.cta')}
          </button>
          <p class="t-caption mirror-cta__note"><Icon name="lock" size={14} /> {t('home.mirror.note')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. Collections ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <SectionHead kicker={t('home.collections.kicker')} title={t('home.collections.title')} action={{ href: href('/collections', locale), label: t('common.viewAll') }} />
    </div>
    <ul class="rail" role="list">
      {
        collections.map((c, i) => (
          <li class="rail__item" data-reveal style={`--reveal-i:${i}`}>
            <a href={href('/collections', locale) + `#${c.slug}`} class="coll">
              {collectionImages[c.slug] ? (
                <div class="coll__media">
                  <Image src={collectionImages[c.slug]} alt="" widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, 80vw" class="coll__img" format="webp" />
                </div>
              ) : (
                <Placeholder label={t('common.comingSoon')} caption={t('common.placeholder')} tone={c.tone} variant="arc" ratio="3 / 4" />
              )}
              <div class="coll__info">
                <p class="label muted">{pick(c.season, locale)}</p>
                <h3 class="coll__name">{pick(c.name, locale)}</h3>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── 7. Atelier band ───────────────────────────────────────────────── -->
  <section class="container atelier" data-reveal>
    <Placeholder label={t('common.placeholder')} caption="Atelier film / photography" variant="lines" ratio="21 / 9" tone="#e3ddd4" class="atelier__ph" />
    <div class="atelier__text">
      <p class="label">{t('home.atelier.kicker')}</p>
      <h2 class="t-h2">{t('home.atelier.title')}</h2>
      <a class="btn btn--primary" href={href('/atelier', locale)}>
        {t('home.atelier.cta')}
        <Icon name="arrow" size={16} flip />
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  /* Hero: auto-advancing crossfade with dot progress, swipe and arrow keys. */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...hero.querySelectorAll<HTMLElement>('[data-tab]')];
    const DURATION = 6500;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;
    const go = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i);
        s.toggleAttribute('aria-hidden', k !== i);
        s.querySelectorAll<HTMLElement>('a, button').forEach((el) => (el.tabIndex = k === i ? 0 : -1));
      });
      tabs.forEach((t, k) => {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', String(k === i));
      });
      void tabs[i].offsetWidth; // restart the CSS progress animation
      tabs[i].classList.add('is-active');
      clearTimeout(timer);
      if (!reduce) timer = window.setTimeout(() => go(i + 1), DURATION);
    };
    hero.style.setProperty('--hero-dur', `${DURATION}ms`);
    tabs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    hero.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      if (e.key === 'ArrowRight') go(i + (rtl ? -1 : 1));
      if (e.key === 'ArrowLeft') go(i + (rtl ? 1 : -1));
    });
    let x0: number | null = null;
    hero.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    hero.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const rtl = document.documentElement.dir === 'rtl';
      if (Math.abs(dx) > 50) go(i + ((dx < 0) !== rtl ? 1 : -1));
      x0 = null;
    });
    go(0);
  }
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: calc(100svh - var(--announce-h));
    min-height: 560px;
    max-height: 1080px;
    overflow: hidden;
    background: var(--stone-200);
    isolation: isolate;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s var(--ease-in-out),
      visibility 0s linear 1.2s;
  }
  .hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.2s var(--ease-in-out);
    z-index: 1;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 8s linear;
  }
  .hero__slide.is-active .hero__img {
    transform: scale(1);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(to bottom, color-mix(in oklab, var(--paper) 50%, transparent), transparent calc(var(--header-h) * 2)),
      linear-gradient(to top, rgb(20 19 18 / 0.18), transparent 30%);
  }
  /* Two buttons, bottom-centre, per slide */
  .hero__actions {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: calc(var(--s-8) + var(--s-2));
    display: flex;
    justify-content: center;
    gap: var(--s-2);
    padding-inline: var(--gutter);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur) var(--ease-out) 0.3s,
      transform var(--dur) var(--ease-out) 0.3s;
  }
  .hero__slide.is-active .hero__actions {
    opacity: 1;
    transform: none;
  }
  .hero__btn {
    min-width: 11rem;
  }
  .hero__btn--glass {
    background: color-mix(in oklab, var(--white) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    color: var(--ink);
  }
  .hero__btn--glass:hover {
    background: var(--white);
  }
  .hero__dots {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: var(--s-6);
    display: flex;
    justify-content: center;
    gap: var(--s-2);
  }
  .hero__dot {
    width: 40px;
    height: 16px;
    display: flex;
    align-items: center;
  }
  .hero__dot span {
    position: relative;
    display: block;
    width: 100%;
    height: 2px;
    background: rgb(20 19 18 / 0.2);
    overflow: hidden;
  }
  .hero__dot span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
  }
  :global([dir='rtl']) .hero__dot span::after {
    transform-origin: right;
  }
  .hero__dot.is-active span::after {
    animation: fill var(--hero-dur, 6500ms) linear forwards;
  }
  @keyframes fill {
    to {
      transform: scaleX(1);
    }
  }
  @media (max-width: 1023px) {
    .hero__actions {
      bottom: calc(var(--tabbar-h) + var(--s-3) + var(--s-8));
    }
    .hero__dots {
      bottom: calc(var(--tabbar-h) + var(--s-3) + var(--s-5));
    }
  }
  @media (max-width: 479px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      padding-inline: var(--s-8);
    }
  }

  /* ── New season grid ───────────────────────────────────────────────── */
  .products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  @media (min-width: 1024px) {
    .products {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ── Lookbook ──────────────────────────────────────────────────────── */
  .lookbook {
    display: grid;
    gap: 2px;
  }
  .look {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--stone-200);
  }
  .look__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out);
  }
  .look:hover .look__img {
    transform: scale(1.03);
  }
  .look::after {
    content: '';
    position: absolute;
    inset: 55% 0 0;
    background: linear-gradient(to top, rgb(20 19 18 / 0.45), transparent);
    pointer-events: none;
  }
  .look__cap {
    position: absolute;
    z-index: 1;
    inset-inline: var(--s-5);
    bottom: var(--s-5);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: var(--white);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.25);
  }
  .look__name {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }
  @media (min-width: 768px) {
    .lookbook {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Mirror CTA ────────────────────────────────────────────────────── */
  .mirror-cta {
    background: var(--ink);
    color: var(--stone-100);
    padding-block: var(--section);
    margin-block-start: var(--section);
  }
  .mirror-cta__inner {
    row-gap: var(--s-7);
    align-items: center;
  }
  .mirror-cta__visual {
    grid-column: 1 / -1;
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .mirror-cta__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mirror-cta__ui {
    position: absolute;
    inset: var(--s-5);
  }
  .mirror-cta__corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 0 solid rgb(255 255 255 / 0.9);
  }
  .mirror-cta__corner:nth-child(1) {
    top: 0;
    left: 0;
    border-width: 1.5px 0 0 1.5px;
  }
  .mirror-cta__corner:nth-child(2) {
    top: 0;
    right: 0;
    border-width: 1.5px 1.5px 0 0;
  }
  .mirror-cta__corner:nth-child(3) {
    bottom: 0;
    left: 0;
    border-width: 0 0 1.5px 1.5px;
  }
  .mirror-cta__corner:nth-child(4) {
    bottom: 0;
    right: 0;
    border-width: 0 1.5px 1.5px 0;
  }
  .mirror-cta__scan {
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--nude-300), transparent);
    box-shadow: 0 0 18px 2px rgb(226 200 178 / 0.6);
    animation: scan 3.6s var(--ease-in-out) infinite alternate;
  }
  @keyframes scan {
    from {
      top: 10%;
    }
    to {
      top: 90%;
    }
  }
  .mirror-cta__text {
    grid-column: 1 / -1;
  }
  .mirror-cta__actions {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .mirror-cta__note {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--stone-500);
  }
  @media (min-width: 1024px) {
    .mirror-cta__visual {
      grid-column: 2 / span 4;
    }
    .mirror-cta__text {
      grid-column: 7 / span 5;
    }
  }

  /* ── Collections rail ──────────────────────────────────────────────── */
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 360px);
    gap: var(--grid-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
    padding-block-end: var(--s-4);
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  .rail__item {
    scroll-snap-align: start;
  }
  .coll {
    display: grid;
    gap: var(--s-3);
  }
  .coll__media {
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stone-200);
  }
  .coll__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.6s var(--ease-out);
  }
  .coll:hover .coll__img {
    transform: scale(1.04);
  }
  .coll__info {
    display: grid;
    gap: var(--s-1);
  }
  .coll__name {
    font-size: var(--text-md);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-snug);
  }
  @media (min-width: 1024px) {
    .rail {
      grid-auto-columns: calc((min(100vw, var(--max)) - 2 * var(--gutter) - 3 * var(--grid-gap)) / 4);
    }
  }

  /* ── Atelier band ──────────────────────────────────────────────────── */
  .atelier {
    position: relative;
    margin-block-start: var(--section);
  }
  .atelier :global(.atelier__ph) {
    aspect-ratio: 4 / 5;
  }
  .atelier :global(.ph__cap) {
    top: var(--s-4);
    bottom: auto;
  }
  .atelier__text {
    position: absolute;
    inset-inline: calc(var(--gutter) + var(--s-6));
    bottom: var(--s-6);
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    max-width: 28rem;
  }
  @media (min-width: 768px) {
    .atelier :global(.atelier__ph) {
      aspect-ratio: 21 / 9;
    }
    .atelier__text {
      inset-inline-start: calc(var(--gutter) + var(--s-8));
      bottom: var(--s-8);
    }
  }
</style>
